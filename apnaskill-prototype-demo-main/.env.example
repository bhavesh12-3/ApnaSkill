# ApnaSkill Environment Variables
# Copy this file to .env and fill in your values.
# The app runs fully in demo/test mode without any of these set.

# ─── Razorpay (Payment Gateway) ────────────────────────────────────────────
# Required for live payment processing.
# Sign up at https://razorpay.com and create a key pair from Dashboard → API Keys.
# IMPORTANT: Never expose RAZORPAY_KEY_SECRET in frontend code.
# Use a backend server to create orders and verify signatures.
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXXXXXX
# RAZORPAY_KEY_SECRET must ONLY be used server-side — never in VITE_ prefixed vars.

# ─── AI Recommendation Engine ──────────────────────────────────────────────
# Optional. If set, the AI engine uses this API for personalized recommendations.
# Without this, the app falls back to the rule-based demo engine.
# VITE_AI_API_URL=https://your-backend.com/api/ai
# Note: Never put your raw OpenAI/Gemini API key here. Route it through a backend proxy.

# ─── App Configuration ─────────────────────────────────────────────────────
VITE_APP_NAME=ApnaSkill
VITE_APP_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=apnaskill@gmail.com

# ─── Feature Flags ─────────────────────────────────────────────────────────
# Set to "true" to enable real payment mode (requires VITE_RAZORPAY_KEY_ID)
VITE_PAYMENT_LIVE_MODE=false
